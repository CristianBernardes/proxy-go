# =============================================
# Configurações do proxy-go
# Copie este arquivo para .env e ajuste
# =============================================

# URL base do Ollama (upstream). Sem autenticação.
# Execução 100% local (go run / make run / serviço systemd): http://localhost:11434
OLLAMA_URL=http://localhost:11434

# Porta local do proxy. Fica DIFERENTE da porta do Ollama (11434) para não
# conflitar — o VS Code/Continue deve apontar para esta porta.
PORT=11435

# Interface onde o proxy escuta. 127.0.0.1 = só esta máquina.
HOST=127.0.0.1

# Só vale para OLLAMA_URL https:// com CA interno.
INSECURE_TLS=false

# Contexto do Ollama (deve casar com OLLAMA_CONTEXT_LENGTH do serviço). O gerador
# de config nunca promete maxInputTokens + maxOutputTokens acima deste valor.
NUM_CTX=32768

# Overrides por modelo (maxInputTokens, maxOutputTokens, toolCalling, vision),
# indexados pelo id do modelo. Ex.: {"qwen2.5:32b": {"toolCalling": false}}
MODELS_OVERRIDES_FILE=models.overrides.json

# Tempo de cache dos modelos em segundos (padrão: 5 minutos)
MODELS_CACHE_TTL=300
