# =============================================
# Configurações do proxy-go
# Copie este arquivo para .env e ajuste
# =============================================

# URL base do Ollama (upstream). Sem autenticação.
# Execução 100% local (go run / make run / serviço systemd): http://localhost:11434
OLLAMA_URL=http://localhost:11434

# Porta local do proxy. Fica DIFERENTE da porta do Ollama (11434) para não
# conflitar — o VS Code/Continue deve apontar para esta porta.
PORT=11435

# Interface onde o proxy escuta. 127.0.0.1 = só esta máquina.
HOST=127.0.0.1

# Só vale para OLLAMA_URL https:// com CA interno.
INSECURE_TLS=false

# Contexto do Ollama (deve casar com OLLAMA_CONTEXT_LENGTH do serviço). O gerador
# de config nunca promete maxInputTokens + maxOutputTokens acima deste valor.
NUM_CTX=32768

# Overrides por modelo (maxInputTokens, maxOutputTokens, toolCalling, vision),
# indexados pelo id do modelo. Ex.: {"qwen2.5:32b": {"toolCalling": false}}
MODELS_OVERRIDES_FILE=models.overrides.json

# Tempo de cache dos modelos em segundos (padrão: 5 minutos)
MODELS_CACHE_TTL=300

# ── Orquestração de Consenso (Mixture of Agents) ─────────────────────────────
# Liga/desliga a feature. Se "false", o proxy ignora o modelo virtual.
ENSEMBLE_ENABLED=true

# Consenso AUTOMÁTICO: se "true", QUALQUER modelo que você escolher vira o Juiz
# e todos os outros modelos do Ollama ajudam por trás. Requisições com "tools"
# (modo agente do Copilot) são desviadas para o fluxo normal.
ENSEMBLE_ALWAYS=true

# Nome do modelo VIRTUAL que o cliente (VS Code/Continue) deve selecionar
# para acionar o comitê. Não existe no Ollama — é resolvido aqui.
ENSEMBLE_MODEL=moa-consensus

# Modelos especialistas consultados EM PARALELO (separados por vírgula).
# Deixe VAZIO para usar automaticamente todos os modelos do Ollama (exceto o
# Juiz escolhido). Preencha para restringir a uma lista fixa.
ENSEMBLE_WORKERS=

# Modelo Juiz FALLBACK, usado só quando o cliente pede o modelo virtual acima.
# Com ENSEMBLE_ALWAYS=true o Juiz é o modelo que você escolher.
ENSEMBLE_JUDGE=llama3.3:latest

# Limite de especialistas consultados por requisição (0 = sem limite).
# Evita disparar dezenas de modelos de uma vez e sobrecarregar o Ollama.
ENSEMBLE_MAX_WORKERS=4

# Timeout máximo (segundos) da fase de fan-out. Workers que estourarem são
# descartados; o juiz sintetiza com as respostas que chegaram a tempo.
ENSEMBLE_TIMEOUT_SECONDS=120

# Consultas simultâneas aos especialistas. 1 evita recarregar modelos grandes
# na VRAM a cada worker.
ENSEMBLE_CONCURRENCY=1
